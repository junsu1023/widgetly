rules_version = '2';

// Skeleton: denies all client reads/writes by default.
// Task 2 fills in per-collection rules (users, tokens, connections, etc).
// signals/pairingCodes/codeAttempts stay server-only (Cloud Functions callable,
// via the Admin SDK, which bypasses these rules) and are never opened to clients.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
