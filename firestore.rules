rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
                    && request.resource.data.nickname is string;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
      match /tokens/{tokenId} { allow read, write: if false; }
    }
    match /connections/{connectionId} {
      // `resource` is null when the requested document doesn't exist, and
      // evaluating `resource.data.memberUids` on null is a rules evaluation
      // error, which the client sees as PERMISSION_DENIED rather than
      // "not found" - so a typo'd connectionId surfaced as a thrown exception
      // instead of "연결 끊김". Allowing the read of a document that doesn't exist
      // leaks nothing (there is no data), and the membership check still gates
      // every document that does exist.
      allow get: if request.auth != null
                  && (resource == null || request.auth.uid in resource.data.memberUids);
      allow list, create, update, delete: if false;
      match /signals/{signalId} {
        allow get: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/connections/$(connectionId)).data.memberUids;
        allow list, create, update, delete: if false;
      }
    }
    match /pairingCodes/{code} { allow read, write: if false; }
    match /codeAttempts/{uid} { allow read, write: if false; }
  }
}
